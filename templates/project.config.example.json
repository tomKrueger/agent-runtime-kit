{
  "packageManager": "pnpm",
  "installCmd": "pnpm install --frozen-lockfile",
  "devCmd": "pnpm dev",
  "migrateCmd": "pnpm db:migrate:local",
  "supabase": {
    "apiPort": 54321,
    "dbPort": 54322,
    "studioPort": 54323
  },
  "envDefaults": {
    "NEXT_PUBLIC_APP_URL": "http://localhost:3000"
  },
  "envKeys": [
    "DATABASE_URL",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY"
  ]
}
